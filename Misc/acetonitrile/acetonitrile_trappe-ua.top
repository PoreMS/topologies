; TraPPE-EH - Transferable Potentials for Phase Equilibria - Explicit Hydrogen - doi.org/10.1021/jp0504827
; e/kb (K) -> e/kb*kb*NA/1000 (kj/mol)

[ defaults ]
; nbfunc        comb-rule       gen-pairs       fudgeLJ fudgeQQ
1               2               yes             0.5          0.83333333

[ atomtypes ]
; name    at.num    mass    charge ptype  sigma      epsilon
c3             6  12.010000  0.00000000  A     0.330      0.0332571
c1             6  12.010000  0.00000000  A     0.348      0.5612131
n1             7  14.010000  0.00000000  A     0.295      0.4988561
hc             1   1.008000  0.00000000  A     0.331      0.1272083













;(*) chrg from Edwards
;LJ from  TraPPE
;A rigid two mass system with the same mom. of inertia
;as MeCN is used to provide a linear molecule. Me, C and
;N are defined as dummies relativ to D1 and D2.


; Thomson force field
; from Kansas





[ moleculetype ]
; Name            nrexcl
ACN          3

[ atoms ]
